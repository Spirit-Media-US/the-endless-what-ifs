---
// The Endless What Ifs — site layout.
// Perf traits: hero preload via <slot name="head"> (2), R2 fonts (4),
// no third-party JS (5), inlineStylesheets auto (6).
import CareBand from '../components/CareBand.astro';
import HundredClubBadge from '../components/HundredClubBadge.astro';
import { img, q, sanityClient } from '../lib/sanity';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: any;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}
const settings = await sanityClient.fetch(q.settings);
const SITE_NAME = settings?.title ?? 'The Endless What Ifs';
const { title, description = settings?.description ?? '', ogImage, jsonLd, noindex = false } = Astro.props;
const share = img(ogImage ?? settings?.shareImage, [1200], 630 / 1200);
const currentYear = new Date().getFullYear();
const siteOrigin = (Astro.site && Astro.site.toString().replace(/\/$/, '')) || '';
const canonicalURL = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : Astro.url.pathname;
const path = Astro.url.pathname;
const nav = [
	{ href: '/', label: 'Her story' },
	{ href: '/work/', label: 'Her work' },
	{ href: '/journals/', label: 'Her journals' },
	{ href: '/book/', label: 'The book' },
	{ href: '/help/', label: 'Find help' },
];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: siteOrigin || undefined };
const ld = [website, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0E0A09" />
		<link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/cormorant/cormorant-300.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/source-sans-3/source-sans-3-400.woff2" crossorigin />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{share && <meta property="og:image" content={share.src} />}
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(ld)} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<CareBand headline={settings?.crisisHeadline} text={settings?.crisisText} />
		<header class="site-head">
			<div class="wrap">
				<a class="brand" href="/">The Endless <i>What Ifs</i></a>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
				<nav class="nav" id="site-nav" aria-label="Main">
					{nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="wrap">
				<div class="cols">
					<div class="foot-lead">
						<p class="ded">{settings?.footerDedication ?? 'In memory of Claire Rose Goodwin, 2003–2024'}</p>
						<p>If you are struggling, you are not alone. <a href="tel:988">Call or text 988</a>, any hour.</p>
					</div>
					<ul>
						<li><a href="/">Her story</a></li>
						<li><a href="/work/">Her work</a></li>
						<li><a href="/journals/">Her journals</a></li>
						<li><a href="/book/">The book</a></li>
					</ul>
					<ul>
						<li><a href="/help/">Find help</a></li>
						<li><a href="/your-story/">Share your story</a></li>
						<li><a href="/haley/">Haley Goodwin — press &amp; speaking</a></li>
						<li><a href="/privacy/">Privacy</a></li>
					</ul>
				</div>
				<p class="copyright">
					&copy; {currentYear} {SITE_NAME}. All rights reserved. &bull; Powered by <a href="https://spiritmediapublishing.com">Spirit Media</a>
					<HundredClubBadge />
				</p>
			</div>
		</footer>
		<script>
			const t = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const n = document.getElementById('site-nav');
			t?.addEventListener('click', () => {
				const open = n?.classList.toggle('open') ?? false;
				t.setAttribute('aria-expanded', String(open));
			});
		</script>
	</body>
</html>
