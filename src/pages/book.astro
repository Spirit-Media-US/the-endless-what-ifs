---
import Layout from '../layouts/Layout.astro';
import { fmtDate, img, q, rich, sanityClient } from '../lib/sanity';
const b = await sanityClient.fetch(q.book);
const cover = img(b?.cover, [400, 700]);
const formats = (b?.formats ?? []).filter((f: any) => f.retailers?.some((r: any) => r.url));
const release = b?.releaseDate ? fmtDate(b.releaseDate) : b?.releaseNote;
const ld = {
	'@context': 'https://schema.org', '@type': 'Book', name: b?.title, alternativeHeadline: b?.subtitle,
	author: { '@type': 'Person', name: b?.author }, image: cover?.src, about: { '@type': 'Person', name: 'Claire Rose Goodwin' },
	...(b?.releaseDate ? { datePublished: b.releaseDate } : {}),
	...(b?.formats?.length ? { workExample: b.formats.filter((f: any) => f.isbn).map((f: any) => ({ '@type': 'Book', isbn: f.isbn, bookFormat: `https://schema.org/${f.format === 'eBook' ? 'EBook' : f.format === 'Audiobook' ? 'AudiobookFormat' : f.format}` })) } : {}),
};
---
<Layout title={b?.seo?.title ?? `${b?.title} — a book by ${b?.author}`} description={b?.seo?.description ?? b?.tagline} ogImage={b?.cover} jsonLd={ld}>
	<section class="wrap sec sec-first book-top">
		<div class="stage3d">
			<div class="book-scene" tabindex="0">
				<div class="book3d">{cover && <img src={cover.src} srcset={cover.srcset} sizes="280px" width={cover.width} height={cover.height} alt={cover.alt} fetchpriority="high" loading="eager" />}</div>
			</div>
			<div class="floor"></div>
		</div>
		<div class="book-info">
			<p class="eyebrow">The book</p>
			<h1 class="h-display">{b?.title}</h1>
			{b?.subtitle && <p class="sub">{b.subtitle}</p>}
			<p class="meta">By {b?.author}{release && ` · ${release}`}</p>
			{b?.tagline && <p class="lede">{b.tagline}</p>}
			{formats.length > 0 ? (
				<div class="buy">
					{formats.map((f: any) => (
						<div class="fmt"><span class="meta">{f.format}{f.price && ` · ${f.price}`}</span>
							<div class="btns">{f.retailers.filter((r: any) => r.url).map((r: any) => <a class="btn" href={r.url} rel="noopener" target="_blank">{r.name}</a>)}</div>
						</div>
					))}
				</div>
			) : (
				<p class="muted">Available soon in hardcover, paperback and eBook. <a href="/haley/#updates">Hear when it’s out</a>.</p>
			)}
		</div>
	</section>
	{b?.authorWhy && (
		<section class="wrap sec">
			<p class="eyebrow">Why Haley wrote it</p>
			<figure class="quote quote-haley"><blockquote class="q">{b.authorWhy}</blockquote><figcaption class="by">{b.author}</figcaption></figure>
		</section>
	)}
	{b?.description && <section class="wrap sec"><p class="eyebrow">About the book</p><div class="prose" set:html={rich(b.description)} /></section>}
	{b?.excerpt && <section class="wrap sec"><p class="eyebrow">Read an excerpt</p>{b.excerptTitle && <h2 class="h-sec">{b.excerptTitle}</h2>}<div class="prose" set:html={rich(b.excerpt)} /></section>}
	<section class="wrap sec">
		<p class="muted">This book talks about suicide. If it brings up something hard for you, you don’t have to carry it alone — <a href="tel:988">call or text 988</a> or visit <a href="/help/">Find help</a>.</p>
	</section>
</Layout>
<style>
	.book-top { display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 1fr); gap: 48px; align-items: center; }
	.book-info { display: flex; flex-direction: column; gap: 16px; }
	.sub { font-family: var(--display); font-style: italic; font-weight: 300; font-size: 25px; color: var(--gold); }
	.buy { display: flex; flex-direction: column; gap: 16px; }
	.fmt { display: flex; flex-direction: column; gap: 8px; }
	.btns { display: flex; flex-wrap: wrap; gap: 10px; }
	@media (max-width: 820px) { .book-top { grid-template-columns: 1fr; } }
</style>
