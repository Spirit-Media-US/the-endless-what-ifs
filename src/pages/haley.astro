---
import Picture from '../components/Picture.astro';
import StoryForm from '../components/StoryForm.astro';
import Layout from '../layouts/Layout.astro';
import { q, rich, sanityClient } from '../lib/sanity';
const a = await sanityClient.fetch(q.author);
const ld = { '@context': 'https://schema.org', '@type': 'Person', name: a?.name, description: a?.shortBio, image: undefined };
---
<Layout title={a?.seo?.title ?? `${a?.name} — author, press & speaking`} description={a?.seo?.description ?? a?.shortBio} ogImage={a?.headshot} jsonLd={ld}>
	<section class="wrap sec sec-first author">
		{a?.headshot && <figure class="frame head"><Picture image={a.headshot} widths={[400, 700]} sizes="(max-width: 820px) 100vw, 340px" eager /></figure>}
		<div class="author-text">
			<p class="eyebrow">The author</p>
			<h1 class="h-display">{a?.name}</h1>
			{a?.shortBio && <p class="lede">{a.shortBio}</p>}
			{a?.bio && <div class="prose" set:html={rich(a.bio)} />}
		</div>
	</section>
	{a?.topics?.length > 0 && (
		<section class="wrap sec"><p class="eyebrow">Speaking</p><ul class="topics">{a.topics.map((t: string) => <li>{t}</li>)}</ul></section>
	)}
	{a?.pressFiles?.length > 0 && (
		<section class="wrap sec"><p class="eyebrow">Press</p><div class="btns">{a.pressFiles.map((f: any) => <a class="btn btn-ghost" href={f.url}>{f.label ?? 'Download'}</a>)}</div></section>
	)}
	<section class="wrap-narrow sec">
		<p class="eyebrow">Press, podcasts &amp; speaking</p>
		<h2 class="h-sec">Invite Haley</h2>
		<StoryForm slug="endless-booking" title="Speaking / press request — The Endless What Ifs" fields="booking" />
	</section>
	<section class="wrap-narrow sec" id="updates">
		<p class="eyebrow">Updates</p>
		<h2 class="h-sec">Hear when the book is out</h2>
		<StoryForm slug="endless-updates" title="Book updates signup — The Endless What Ifs" fields="signup" />
	</section>
</Layout>
<style>
	.author { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 48px; align-items: start; }
	.author-text { display: flex; flex-direction: column; gap: 18px; }
	.head { margin: 0; }
	.topics { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; color: var(--muted); }
	.btns { display: flex; flex-wrap: wrap; gap: 10px; }
	@media (max-width: 820px) { .author { grid-template-columns: 1fr; } }
</style>
