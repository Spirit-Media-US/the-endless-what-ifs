---
import Picture from '../../components/Picture.astro';
import Layout from '../../layouts/Layout.astro';
import { q, sanityClient } from '../../lib/sanity';
const photos = await sanityClient.fetch(q.photos);
const sets = [...new Set(photos.map((p: any) => p.set ?? 'Photographs'))] as string[];
---
<Layout title="Photographs — Claire Rose Goodwin" description="Photographs of Claire Goodwin on stage and in recital.">
	<section class="wrap sec sec-first">
		<p class="eyebrow"><a class="plain" href="/work/">Her work</a> · Photographs</p>
		<h1 class="h-display">In the light</h1>
	</section>
	{sets.map((set) => (
		<section class="wrap sec">
			<p class="eyebrow">{set}</p>
			<div class="grid-photos">
				{photos.filter((p: any) => (p.set ?? 'Photographs') === set).map((p: any) => (
					<figure class="ph">
						<div class="frame"><Picture image={p.image} widths={[400, 800, 1200]} sizes="(max-width: 820px) 100vw, 330px" /></div>
						{(p.title || p.image?.caption) && <figcaption class="cap">{p.title && <b>{p.title}</b>}{p.image?.caption}</figcaption>}
					</figure>
				))}
			</div>
		</section>
	))}
</Layout>
<style>.plain { color: inherit; text-decoration: none; } .ph { margin: 0; display: flex; flex-direction: column; gap: 10px; }</style>
