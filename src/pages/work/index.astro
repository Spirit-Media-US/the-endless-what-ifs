---
import Picture from '../../components/Picture.astro';
import Layout from '../../layouts/Layout.astro';
import { fmtDate, q, sanityClient } from '../../lib/sanity';

const [programmes, stages, photos] = await Promise.all([
	sanityClient.fetch(q.programmes),
	sanityClient.fetch(q.stages),
	sanityClient.fetch(q.photos),
]);
---
<Layout title="Her work — Claire Rose Goodwin" description="Claire Goodwin’s performances, the operas and festivals she sang in, and photographs from the stage.">
	<section class="wrap sec sec-first">
		<p class="eyebrow">Her work</p>
		<h1 class="h-display">On stage</h1>
		<p class="lede">Claire studied voice performance for opera at Florida State University’s College of Music. She sang in seven languages at her junior recital, and planned more for her senior one. This is the record of her work — one piece at a time, given room.</p>
	</section>

	{programmes.map((p: any) => (
		<section class="wrap sec">
			<div class="prog-head">
				<div>
					<p class="eyebrow">Programme · {fmtDate(p.date)}</p>
					<h2 class="h-sec"><a class="plain" href={`/work/${p.slug}/`}>{p.title}</a></h2>
					{p.venue && <p class="muted">{p.venue}</p>}
				</div>
				<a class="btn btn-ghost" href={`/work/${p.slug}/`}>The full programme</a>
			</div>
			{p.summary && <p class="lede">{p.summary}</p>}
			<div class="programme">
				{p.performances.map((s: any, i: number) => (
					<a class="prog-row" href={`/work/${s.slug}/`}>
						<span class="prog-no">{String(i + 1).padStart(2, '0')}</span>
						<span class="prog-thumb">{s.poster && <Picture image={s.poster} widths={[240]} ratio={9 / 16} sizes="120px" />}</span>
						<span><span class="prog-title">{s.title}</span><br /><span class="prog-sub">{[s.composer, s.duration].filter(Boolean).join(' · ')}</span></span>
						<span class="prog-lang">{s.language}</span>
					</a>
				))}
			</div>
		</section>
	))}

	{stages.length > 0 && (
		<section class="wrap sec">
			<p class="eyebrow">Her stages</p>
			<h2 class="h-sec">Where she sang</h2>
			<div class="timeline">
				{stages.slice(0, 5).map((s: any) => (
					<div class="tl"><span class="y">{s.year ?? s.kind}</span><span class="t">{s.title}</span>{s.place && <span class="p">{s.place}</span>}</div>
				))}
			</div>
			<p><a href="/work/stages/">Every stage &rarr;</a></p>
		</section>
	)}

	{photos.length > 0 && (
		<section class="wrap sec">
			<p class="eyebrow">Photographs</p>
			<h2 class="h-sec">In the light</h2>
			<div class="grid-photos">
				{photos.slice(0, 6).map((ph: any) => (
					<figure class="ph"><div class="frame"><Picture image={ph.image} widths={[400, 700]} sizes="(max-width: 820px) 100vw, 330px" /></div></figure>
				))}
			</div>
			<p><a href="/work/photographs/">All photographs &rarr;</a></p>
		</section>
	)}
</Layout>

<style>
	.prog-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 18px; }
	.prog-head > div { display: flex; flex-direction: column; gap: 10px; }
	.plain { color: inherit; text-decoration: none; }
	.plain:hover { color: var(--gold); }
	.ph { margin: 0; }
</style>
