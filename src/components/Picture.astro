---
import { img } from '../lib/sanity';
interface Props { image: any; widths?: number[]; ratio?: number; sizes?: string; eager?: boolean; class?: string }
const { image, widths, ratio, sizes = '(max-width: 1040px) 100vw, 1040px', eager = false, class: cls } = Astro.props;
const i = img(image, widths, ratio);
---
{i && (
	<img
		src={i.src}
		srcset={i.srcset}
		sizes={sizes}
		width={i.width}
		height={i.height}
		alt={i.alt}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : undefined}
		decoding="async"
		class={cls}
	/>
)}
