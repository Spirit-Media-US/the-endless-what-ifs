---
// Posts to /api/submit (the same handler as forms.spiritmediapublishing.com):
// Mailgun email to the team + a tagged GHL contact note. Nothing is ever published.
interface Props { slug: string; title: string; fields: 'story' | 'booking' | 'signup' }
const { slug, title, fields } = Astro.props;
const id = `f-${slug}`;
---
<form class="sform" id={id} data-slug={slug} data-title={title} novalidate>
	<div class="field"><label for={`${id}-name`}>Your name</label><input id={`${id}-name`} name="client_name" autocomplete="name" required /></div>
	<div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required /></div>
	{fields === 'story' && (
		<>
			<div class="field"><label for={`${id}-story`}>Your story</label><span class="hint">Share as much or as little as you like.</span><textarea id={`${id}-story`} name="story" required></textarea></div>
			<label class="check"><input type="checkbox" name="may_contact" value="yes" /> Haley may contact me about my story.</label>
		</>
	)}
	{fields === 'booking' && (
		<>
			<div class="field"><label for={`${id}-org`}>Organization or show</label><input id={`${id}-org`} name="organization" /></div>
			<div class="field"><label for={`${id}-kind`}>What are you inviting Haley to?</label>
				<select id={`${id}-kind`} name="request_type"><option>Interview or podcast</option><option>Speaking event</option><option>Press / media</option><option>Something else</option></select></div>
			<div class="field"><label for={`${id}-date`}>Date (if known)</label><input id={`${id}-date`} name="date" /></div>
			<div class="field"><label for={`${id}-msg`}>Details</label><textarea id={`${id}-msg`} name="details"></textarea></div>
		</>
	)}
	<input class="hp" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
	<button class="btn" type="submit">{fields === 'signup' ? 'Keep me posted' : 'Send'}</button>
	<p class="status" role="status" aria-live="polite"></p>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>('form.sform').forEach((form) => {
		const status = form.querySelector<HTMLElement>('.status')!;
		form.addEventListener('submit', async (ev) => {
			ev.preventDefault();
			if (!form.reportValidity()) return;
			const answers = Object.fromEntries(new FormData(form).entries());
			const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
			btn.disabled = true;
			status.textContent = 'Sending…';
			try {
				const res = await fetch('/api/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ slug: form.dataset.slug, title: form.dataset.title, page: location.pathname, answers }),
				});
				if (!res.ok) throw new Error(String(res.status));
				location.href = '/thank-you/';
			} catch {
				btn.disabled = false;
				status.textContent = 'Something went wrong sending this. Please try again in a moment.';
			}
		});
	});
</script>

<style>
	.sform { display: flex; flex-direction: column; gap: 18px; margin-top: 12px; }
	.sform .btn { align-self: flex-start; }
	.hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
	.status { font-size: 14px; color: var(--muted); min-height: 1.4em; }
</style>
